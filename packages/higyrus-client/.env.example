# Required
HIGYRUS_USER=tu_usuario
HIGYRUS_PASSWORD=tu_password
HIGYRUS_BASE_URL=https://cliente.aunesa.com/Irmo

# Optional — single-tenant installations can leave it empty; it is still
# sent in the login body as "" to keep the request shape consistent.
HIGYRUS_CLIENT_ID=

# Optional — used by main_higyrus.py driver (Phase 4)
# HIGYRUS_SAMPLE_CUENTA: override del cuentas[0].id auto-resuelto (sino vacío = primer cuenta en estado=alta)
HIGYRUS_SAMPLE_CUENTA=
# HIGYRUS_SAMPLE_TIPO_CUENTA: tipo de cuenta para get_posicion_valuada (default 'propia')
HIGYRUS_SAMPLE_TIPO_CUENTA=
# HIGYRUS_SAMPLE_NIVEL: nivel para get_posicion_valuada (default 'detalle')
HIGYRUS_SAMPLE_NIVEL=

# Optional — opt-in flag for probe_auth_401 (Phase 4)
# Setear =1 para forzar un intento de login con password inválido y verificar el path 401.
# SINGLE-SHOT por ejecución del driver; sin retry, sin loops.
# CRÍTICO: solo activar deliberadamente; cada run consume 1 intento de auth fallido contra la cuenta real.
VERIFY_HIGYRUS_BAD_CREDS=
