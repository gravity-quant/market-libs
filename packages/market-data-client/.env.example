# Credenciales Auth0 (grant client_credentials) para market-data-client.
# Copiar a `.env` y completar con valores reales. NUNCA commitear `.env`.

MARKET_DATA_CLIENT_ID=your-auth0-client-id
MARKET_DATA_CLIENT_SECRET=your-auth0-client-secret
MARKET_DATA_AUDIENCE=your-auth0-api-audience
MARKET_DATA_AUTH0_TOKEN_URL=https://<tenant>.auth0.com/oauth/token
MARKET_DATA_BASE_URL=https://market-data-develop.bbsa.com.ar/api
